
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Management System</title>
<style>
body{font-family:Arial;background:#f3f5f7;margin:0;color:#222}
header{background:#263b50;color:white;padding:20px;text-align:center}
nav{background:#34495e;padding:12px;text-align:center}
nav button{margin:4px;padding:10px;border:0;border-radius:5px;cursor:pointer}
main{max-width:900px;margin:20px auto;padding:20px;background:white;border-radius:10px}
input,button{padding:10px;margin:5px;box-sizing:border-box}
input{max-width:100%}
button{cursor:pointer;background:#263b50;color:white;border:0;border-radius:4px}
section{margin-bottom:25px}
.book{border:1px solid #ddd;padding:12px;margin:8px 0;border-radius:5px}
.hidden{display:none}
</style>
</head>
<body>
<header>
<h1>Library Management System</h1>
<p>Search, issue and manage books easily</p>
</header>

<nav>
<button onclick="show('catalog')">Book Catalog</button>
<button onclick="show('login')">Login</button>
<button onclick="show('account')">My Books</button>
<button onclick="show('admin')">Admin</button>
<button onclick="show('contact')">Contact</button>
</nav>

<main>
<section id="catalog">
<h2>Search Books</h2>
<input id="search" placeholder="Enter book title or author"
oninput="displayBooks()">
<div id="bookList"></div>
</section>

<section id="login" class="hidden">
<h2>Student Login</h2>
<input id="username" placeholder="Enter student name">
<button onclick="login()">Login</button>
<p id="loginMessage"></p>
</section>

<section id="account" class="hidden">
<h2>My Borrowed Books</h2>
<p id="userInfo">Please login first.</p>
<div id="myBooks"></div>
</section>

<section id="admin" class="hidden">
<h2>Admin Dashboard</h2>
<p>Demo password: admin123</p>
<input id="adminPass" type="password" placeholder="Admin password">
<button onclick="adminLogin()">Admin Login</button>
<div id="adminPanel" class="hidden">
<h3>Add a Book</h3>
<input id="newTitle" placeholder="Book title">
<input id="newAuthor" placeholder="Author">
<input id="newCopies" type="number" min="1" value="1"
placeholder="Copies">
<button onclick="addBook()">Add Book</button>
<h3>Inventory</h3>
<div id="inventory"></div>
</div>
</section>

<section id="contact" class="hidden">
<h2>Contact Library</h2>
<form onsubmit="contact(event)">
<input id="contactName" placeholder="Your name" required>
<input id="contactEmail" type="email" placeholder="Your email" required>
<br>
<textarea id="message" placeholder="Your message" required></textarea>
<br><button type="submit">Send Message</button>
</form>
<p id="contactMessage"></p>
</section>
</main>

<script>
let books = JSON.parse(localStorage.getItem("books")) || [
{id:1,title:"Wings of Fire",author:"A.P.J. Abdul Kalam",total:3,available:3},
{id:2,title:"The Alchemist",author:"Paulo Coelho",total:2,available:2},
{id:3,title:"Java Programming",author:"Herbert Schildt",total:4,available:4}
];

let loans = JSON.parse(localStorage.getItem("loans")) || [];
let user = sessionStorage.getItem("libraryUser") || "";

function save(){
 localStorage.setItem("books",JSON.stringify(books));
 localStorage.setItem("loans",JSON.stringify(loans));
}

function show(id){
 document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));
 document.getElementById(id).classList.remove("hidden");
 if(id==="catalog")displayBooks();
 if(id==="account")displayMyBooks();
 if(id==="admin" && !document.getElementById("adminPanel").classList.contains("hidden"))displayInventory();
}

function displayBooks(){
 let q=document.getElementById("search").value.toLowerCase();
 let list=document.getElementById("bookList");
 list.innerHTML="";
 books.filter(b=>(b.title+" "+b.author).toLowerCase().includes(q))
 .forEach(b=>{
 list.innerHTML+=`<div class="book">
 <h3>${b.title}</h3><p>Author: ${b.author}</p>
 <p>Available: ${b.available} / ${b.total}</p>
 <button onclick="details(${b.id})">Book Details</button>
 <button onclick="issue(${b.id})">Borrow</button>
 </div>`;
 });
 if(!list.innerHTML)list.textContent="No books found.";
}

function details(id){
 let b=books.find(x=>x.id===id);
 alert("Title: "+b.title+"\nAuthor: "+b.author+
 "\nAvailable copies: "+b.available);
}

function login(){
 let name=document.getElementById("username").value.trim();
 if(!name)return alert("Enter your name");
 user=name;
 sessionStorage.setItem("libraryUser",user);
 document.getElementById("loginMessage").textContent="Welcome, "+user;
 displayMyBooks();
}

function issue(id){
 if(!user){alert("Please login first");show("login");return;}
 let b=books.find(x=>x.id===id);
 if(b.available<1)return alert("Book unavailable");
 if(loans.some(l=>l.user===user&&l.bookId===id&&!l.returned))
 return alert("You already borrowed this book");
 b.available--;
 loans.push({user,bookId:id,issueDate:Date.now(),
 dueDate:Date.now()+7*86400000,returned:false});
 save();displayBooks();
 alert("Book borrowed! Due in 7 days.");
}

function displayMyBooks(){
 document.getElementById("userInfo").textContent=
 user?"Logged in as: "+user:"Please login first.";
 let div=document.getElementById("myBooks");
 div.innerHTML="";
 loans.filter(l=>l.user===user&&!l.returned).forEach(l=>{
 let b=books.find(x=>x.id===l.bookId);
 if(!b)return;
 let days=Math.max(0,Math.ceil((Date.now()-l.dueDate)/86400000));
 div.innerHTML+=`<div class="book">
 <b>${b.title}</b><p>Due: ${new Date(l.dueDate).toLocaleDateString()}</p>
 <p>Current overdue fine: ₹${days*2}</p>
 <button onclick="returnBook(${l.bookId})">Return Book</button>
 </div>`;
 });
}

function returnBook(id){
 let l=loans.find(x=>x.user===user&&x.bookId===id&&!x.returned);
 if(!l)return;
 let days=Math.max(0,Math.ceil((Date.now()-l.dueDate)/86400000));
 alert("Book returned. Fine: ₹"+(days*2));
 l.returned=true;
 let b=books.find(x=>x.id===id);
 if(b)b.available++;
 save();displayMyBooks();displayBooks();
}

function adminLogin(){
 if(document.getElementById("adminPass").value==="admin123"){
 document.getElementById("adminPanel").classList.remove("hidden");
 displayInventory();
 }else alert("Incorrect admin password");
}

function addBook(){
 let title=document.getElementById("newTitle").value.trim();
 let author=document.getElementById("newAuthor").value.trim();
 let copies=Number(document.getElementById("newCopies").value);
 if(!title||!author||!Number.isInteger(copies)||copies<1)
 return alert("Enter valid book details");
 books.push({id:Date.now(),title,author,total:copies,available:copies});
 save();displayInventory();displayBooks();
 document.getElementById("newTitle").value="";
 document.getElementById("newAuthor").value="";
}

function displayInventory(){
 let div=document.getElementById("inventory");
 div.innerHTML="";
 books.forEach(b=>{
 div.innerHTML+=`<div class="book">${b.title} — ${b.available}/${b.total} available
 <button onclick="deleteBook(${b.id})">Delete</button></div>`;
 });
}

function deleteBook(id){
 if(loans.some(l=>l.bookId===id&&!l.returned))
 return alert("Cannot delete a book currently borrowed");
 books=books.filter(b=>b.id!==id);
 save();displayInventory();displayBooks();
}

function contact(e){
 e.preventDefault();
 document.getElementById("contactMessage").textContent=
 "Thank you! Your message has been recorded for this demo.";
 e.target.reset();
}

displayBooks();
</script>
</body>
</html>
