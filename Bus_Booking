
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Bus Ticket Booking</title>
<style>
body{font-family:Arial;margin:0;background:#f2f5f8;color:#222}
header{background:#17365d;color:white;text-align:center;padding:22px}
nav{background:#245080;text-align:center;padding:12px}
button{background:#1769aa;color:white;border:0;padding:10px;
margin:4px;border-radius:5px;cursor:pointer}
main{max-width:900px;margin:20px auto;background:white;padding:20px;
border-radius:10px}
input,select{padding:10px;margin:5px;max-width:95%}
.bus{border:1px solid #ddd;padding:15px;margin:12px 0;border-radius:8px}
.hidden{display:none}
.seats{display:grid;grid-template-columns:repeat(4,55px);gap:8px}
.seat{background:#d9f0df;color:#222}
.seat.selected{background:#1976d2;color:white}
.seat.booked{background:#aaa;color:white;cursor:not-allowed}
</style>
</head>
<body>

<header>
<h1>BusGo Ticket Booking</h1>
<p>Book your journey with ease</p>
</header>

<nav>
<button onclick="show('search')">Search Buses</button>
<button onclick="show('login')">Login</button>
<button onclick="show('dashboard')">My Bookings</button>
<button onclick="show('admin')">Admin</button>
</nav>

<main>
<section id="search">
<h2>Search Buses</h2>
<input id="from" placeholder="From city">
<input id="to" placeholder="To city">
<input id="travelDate" type="date">
<button onclick="searchBuses()">Search</button>
<div id="busList"></div>
</section>

<section id="login" class="hidden">
<h2>User Login</h2>
<input id="username" placeholder="Enter your name">
<button onclick="login()">Login</button>
<p id="loginStatus"></p>
</section>

<section id="booking" class="hidden">
<h2>Select Seats</h2>
<div id="busInfo"></div>
<p>Green = Available | Blue = Selected | Grey = Booked</p>
<div class="seats" id="seatList"></div>
<h3>Passenger Details</h3>
<form onsubmit="confirmBooking(event)">
<input id="passenger" placeholder="Passenger name" required>
<input id="passengerAge" type="number" min="1" max="120"
placeholder="Age" required>
<input id="passengerEmail" type="email" placeholder="Email" required>
<br><button type="submit">Confirm Booking</button>
</form>
<p id="bookingMessage"></p>
</section>

<section id="dashboard" class="hidden">
<h2>My Bookings</h2>
<div id="myBookings"></div>
</section>

<section id="admin" class="hidden">
<h2>Admin Panel</h2>
<p>Demo password: admin123</p>
<input id="adminPassword" type="password" placeholder="Admin password">
<button onclick="adminLogin()">Login as Admin</button>
<div id="adminPanel" class="hidden">
<h3>Add Bus</h3>
<input id="busName" placeholder="Bus name">
<input id="busFrom" placeholder="From">
<input id="busTo" placeholder="To">
<input id="busTime" type="time">
<input id="busPrice" type="number" min="1" placeholder="Ticket price">
<input id="busDate" type="date">
<button onclick="addBus()">Add Bus</button>
<h3>Bus Schedule</h3>
<div id="inventory"></div>
<h3>All Bookings</h3>
<div id="allBookings"></div>
</div>
</section>
</main>

<script>
let buses=JSON.parse(localStorage.getItem("buses"))||[
{id:1,name:"Express Travels",from:"Chennai",to:"Bangalore",
time:"08:00",date:"",price:650,seats:20,booked:[]},
{id:2,name:"City Bus Service",from:"Chennai",to:"Madurai",
time:"21:00",date:"",price:550,seats:20,booked:[]},
{id:3,name:"Royal Travels",from:"Bangalore",to:"Chennai",
time:"22:00",date:"",price:700,seats:20,booked:[]}
];

let bookings=JSON.parse(localStorage.getItem("busBookings"))||[];
let user=sessionStorage.getItem("busUser")||"";
let selectedBus=null;
let selectedSeats=[];

function save(){
localStorage.setItem("buses",JSON.stringify(buses));
localStorage.setItem("busBookings",JSON.stringify(bookings));
}

function show(id){
document.querySelectorAll("main section").forEach(s=>s.classList.add("hidden"));
document.getElementById(id).classList.remove("hidden");
if(id==="search")searchBuses();
if(id==="dashboard")displayBookings();
if(id==="admin"&&!document.getElementById("adminPanel").classList.contains("hidden"))displayAdmin();
}

function searchBuses(){
let from=document.getElementById("from").value.trim().toLowerCase();
let to=document.getElementById("to").value.trim().toLowerCase();
let date=document.getElementById("travelDate").value;
let list=document.getElementById("busList");
list.innerHTML="";

buses.filter(b=>
b.from.toLowerCase().includes(from)&&
b.to.toLowerCase().includes(to)&&
(!date||!b.date||b.date===date)
).forEach(b=>{
list.innerHTML+=`<div class="bus">
<h3>${b.name}</h3>
<p>${b.from} → ${b.to}</p>
<p>Date: ${b.date||"Flexible demo date"} | Departure: ${b.time}</p>
<p>Available seats: ${b.seats-b.booked.length}</p>
<p>Ticket price: ₹${b.price}</p>
<button onclick="selectBus(${b.id})">Select Seats</button>
</div>`;
});
if(!list.innerHTML)list.textContent="No buses found.";
}

function login(){
let name=document.getElementById("username").value.trim();
if(!name)return alert("Enter your name");
user=name;
sessionStorage.setItem("busUser",user);
document.getElementById("loginStatus").textContent="Welcome, "+user;
}

function selectBus(id){
if(!user){alert("Please login first");show("login");return;}
selectedBus=buses.find(b=>b.id===id);
selectedSeats=[];
document.getElementById("bookingMessage").textContent="";
document.getElementById("passenger").value="";
document.getElementById("passengerAge").value="";
document.getElementById("passengerEmail").value="";
document.getElementById("busInfo").textContent=
selectedBus.name+" | "+selectedBus.from+" to "+selectedBus.to+
" | ₹"+selectedBus.price+" per seat";
renderSeats();
show("booking");
}

function renderSeats(){
let list=document.getElementById("seatList");
list.innerHTML="";
for(let i=1;i<=selectedBus.seats;i++){
let btn=document.createElement("button");
btn.textContent=i;
btn.className="seat";
if(selectedBus.booked.includes(i))btn.classList.add("booked");
if(selectedSeats.includes(i))btn.classList.add("selected");
btn.disabled=selectedBus.booked.includes(i);
btn.onclick=()=>{
if(selectedSeats.includes(i))
selectedSeats=selectedSeats.filter(s=>s!==i);
else selectedSeats.push(i);
renderSeats();
};
list.appendChild(btn);
}
let p=document.createElement("p");
p.textContent="Selected seats: "+(selectedSeats.join(", ")||"None")+
" | Total: ₹"+(selectedSeats.length*selectedBus.price);
list.appendChild(p);
}

function confirmBooking(e){
e.preventDefault();
if(!selectedBus||selectedSeats.length===0)
return alert("Please select at least one seat");

if(selectedSeats.some(s=>selectedBus.booked.includes(s)))
return alert("A selected seat is no longer available");

let passenger=document.getElementById("passenger").value.trim();
let age=Number(document.getElementById("passengerAge").value);
let email=document.getElementById("passengerEmail").value.trim();
if(!passenger||age<1||age>120||!email)
return alert("Enter valid passenger details");

let date=document.getElementById("travelDate").value||selectedBus.date;
if(!date)return alert("Please select a travel date");

let booking={
id:Date.now(),user:user,busId:selectedBus.id,
bus:selectedBus.name,from:selectedBus.from,to:selectedBus.to,
date:date,time:selectedBus.time,seats:[...selectedSeats],
passenger:passenger,age:age,email:email,
total:selectedSeats.length*selectedBus.price,status:"Confirmed"
};

selectedBus.booked.push(...selectedSeats);
bookings.push(booking);
save();
document.getElementById("bookingMessage").textContent=
"Booking confirmed! ID: "+booking.id+
" | Seats: "+booking.seats.join(", ")+
" | Total: ₹"+booking.total;
selectedSeats=[];
renderSeats();
searchBuses();
}

function displayBookings(){
let list=document.getElementById("myBookings");
list.innerHTML="";
let mine=bookings.filter(b=>b.user===user);
if(!user){list.textContent="Please login to view your bookings.";return;}
if(!mine.length){list.textContent="No bookings yet.";return;}

mine.forEach(b=>{
list.innerHTML+=`<div class="bus">
<h3>${b.bus}</h3>
<p>${b.from} → ${b.to}</p>
<p>Date: ${b.date} | Time: ${b.time}</p>
<p>Passenger: ${b.passenger} | Seats: ${b.seats.join(", ")}</p>
<p>Total: ₹${b.total} | ${b.status}</p>
${b.status==="Confirmed"?`<button onclick="cancelBooking(${b.id})">Cancel Booking</button>`:""}
</div>`;
});
}

function cancelBooking(id){
let b=bookings.find(x=>x.id===id&&x.user===user);
if(!b||b.status!=="Confirmed")return;
b.status="Cancelled";
let bus=buses.find(x=>x.id===b.busId);
if(bus)bus.booked=bus.booked.filter(s=>!b.seats.includes(s));
save();displayBookings();searchBuses();
}

function adminLogin(){
if(document.getElementById("adminPassword").value==="admin123"){
document.getElementById("adminPanel").classList.remove("hidden");
displayAdmin();
}else alert("Incorrect password");
}

function addBus(){
let name=document.getElementById("busName").value.trim();
let from=document.getElementById("busFrom").value.trim();
let to=document.getElementById("busTo").value.trim();
let time=document.getElementById("busTime").value;
let price=Number(document.getElementById("busPrice").value);
let date=document.getElementById("busDate").value;

if(!name||!from||!to||!time||!date||price<=0)
return alert("Enter valid bus details");

buses.push({id:Date.now(),name,from,to,time,date,price,seats:20,booked:[]});
save();displayAdmin();searchBuses();
}

function displayAdmin(){
document.getElementById("inventory").innerHTML=buses.map(b=>
`<div class="bus">${b.name}: ${b.from} → ${b.to},
${b.date||"Flexible date"}, ${b.time}, ₹${b.price},
Available: ${b.seats-b.booked.length}
<button onclick="deleteBus(${b.id})">Delete</button></div>`
).join("");

document.getElementById("allBookings").innerHTML=bookings.map(b=>
`<div class="bus">ID: ${b.id} | ${b.passenger} | ${b.bus} |
${b.date} | Seats: ${b.seats.join(", ")} |
₹${b.total} | ${b.status}</div>`
).join("")||"No bookings yet.";
}

function deleteBus(id){
if(bookings.some(b=>b.busId===id&&b.status==="Confirmed"))
return alert("Cancel confirmed bookings before deleting this bus");
buses=buses.filter(b=>b.id!==id);
save();displayAdmin();searchBuses();
}

document.getElementById("travelDate").min=new Date().toLocaleDateString("en-CA");
document.getElementById("busDate").min=new Date().toLocaleDateString("en-CA");
searchBuses();
</script>
</body>
</html>
